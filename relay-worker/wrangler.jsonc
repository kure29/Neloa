{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neloa-relay",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-18",
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY_OBJECT",
        "class_name": "RelayObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RelayObject"]
    }
  ],
  "vars": {
    "NELOA_RELAY_MAX_DEVICES": "64"
  },
  "observability": {
    "enabled": true
  }
}
